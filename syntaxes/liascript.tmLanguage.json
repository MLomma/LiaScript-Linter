        {
          "name": "markup.fenced_code.block.markdown",
          "begin": "(?:^|\\G)([ \\t]*)(`{3,}|~{3,})[ \\t]*((?i:css))[ \\t]+(@[\\w][\\w.-]*(?:\\([^\\r\\n]*)?)[ \\t]*\\r?$",
          "beginCaptures": {
