            }
          },
          "patterns": [
            {
              "begin": "(?:^|\\G)(?=.)",
              "while": "(?:^|\\G)(?![ \\t]*[`~]{3,}[ \\t]*\\r?$)",
              "contentName": "meta.embedded.block.css",
              "patterns": [
